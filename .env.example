# ─────────────────────────────────────────────────────────────
# Casa Cinco de Mayo — Channel Manager — env template
# Copy to .env and fill in. See ACTION-ITEMS.md for how to get each.
# ─────────────────────────────────────────────────────────────

# Database — Postgres (Neon / Vercel Postgres). Use the POOLED connection string.
# On Vercel: add the Postgres (Neon) integration under Storage and it injects
# DATABASE_URL automatically. Locally: create a free Neon project and paste its
# pooled connection string here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Connectivity aggregator (holds the certified OTA connections)
CHANNEL_ADAPTER="mock"            # mock | channex | nextpax
CHANNEX_API_KEY="your-channex-key"
NEXTPAX_API_KEY="your-nextpax-key"

# Payments
PAYMENTS_PROVIDER="none"          # none | stripe | mercadopago
STRIPE_SECRET_KEY="sk_test_..."
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEFAULT_CURRENCY="MXN"
